# ================================================================
# STAFFSTAY BACKEND — VARIÁVEIS DE AMBIENTE
# ================================================================
# ATENÇÃO: Nunca faça commit deste arquivo com valores reais!
# Use .env.example para compartilhar a estrutura.
# No EasyPanel, adicione cada variável na aba "Environment".
# ================================================================

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Banco de Dados PostgreSQL ────────────────────────────────────
# EasyPanel gera esta URL automaticamente.
# Cole o "Internal Connection URL" do painel do banco:
DATABASE_URL=postgres://postpermuta:142635Pe@dados_postpermuta:5432/postpermuta?sslmode=disable

# ── Autenticação JWT ─────────────────────────────────────────────
# IMPORTANTE: Gere valores únicos e longos (mínimo 64 chars)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SUBSTITUIR_POR_STRING_ALEATORIA_DE_64_BYTES_MINIMO
JWT_REFRESH_SECRET=SUBSTITUIR_POR_OUTRA_STRING_ALEATORIA_DIFERENTE

# ── Segurança ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS — Origens permitidas (separadas por vírgula) ────────────
# Coloque o domínio do seu frontend no EasyPanel
CORS_ORIGIN=https://staffstay.com.br,https://www.staffstay.com.br

# ── Notificações (futuro) ────────────────────────────────────────
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_API_TOKEN=

# ── Gateway de Pagamento (futuro) ───────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
# PAGARME_API_KEY=
